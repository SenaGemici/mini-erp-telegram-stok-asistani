      "id": "ec871883-f9d9-4c68-9e0b-1430665b9e02",
      "name": "If1"
    },
    {
      "parameters": {
        "jsCode": "const intent = $input.first().json;\nconst products = $('Aggregate').first().json.products;\n\nconst normalize = value =>\n  String(value ?? '').trim().toLocaleLowerCase('tr-TR');\n\nconst finish = (reply, extra = {}) => [{\n  json: { ...intent, can_update: false, reply, ...extra }\n}];\n\nconst allowed = ['sale', 'return', 'receipt', 'set'];\n\nif (!allowed.includes(intent.operation)) {\n  return finish('İşlemi anlayamadım. Ürün ve yapmak istediğin işlemi yazar mısın?');\n}\n\nif (!intent.product_name) {\n  return finish('Hangi ürün için işlem yapmak istiyorsun?');\n}\n\nconst matches = products.filter(p =>\n  normalize(p.product_name) === normalize(intent.product_name)\n);\n\nif (matches.length === 0) {\n  return finish(`\"${intent.product_name}\" adlı ürün bulunamadı.`);\n}\n\nif (matches.length > 1) {\n  return finish('Birden fazla ürün eşleşti. Ürünü netleştirir misin?');\n}\n\nconst quantity = intent.quantity;\n\nif (\n  typeof quantity !== 'number' ||\n  !Number.isSafeInteger(quantity) ||\n  quantity < 0 ||\n  (intent.operation !== 'set' && quantity === 0)\n) {\n  return finish('Geçerli bir adet belirtir misin?');\n}\n\nconst product = matches[0];\nconst before = Number(product.stock);\n\nif (\n  product.stock === '' ||\n  product.stock == null ||\n  !Number.isSafeInteger(before) ||\n  before < 0\n) {\n  return finish('Tablodaki stok değeri geçersiz. İşlem yapılmadı.');\n}\n\nlet after;\n\nswitch (intent.operation) {\n  case 'sale':\n    after = before - quantity;\n    break;\n  case 'return':\n  case 'receipt':\n    after = before + quantity;\n    break;\n  case 'set':\n    after = quantity;\n    break;\n}\n\nif (after < 0) {\n  return finish(\n    `Yetersiz stok. ${product.product_name} için mevcut stok: ${before} adet.`\n  );\n}\n\nif (!Number.isSafeInteger(after)) {\n  return finish('Miktar çok büyük. İşlem yapılmadı.');\n}\n\nreturn finish('Stok değişikliği hesaplandı; henüz kaydedilmedi.', {\n  can_update: true,\n  sku: product.sku,\n  product_name: product.product_name,\n  quantity,\n  before,\n  after,\n  source_text: $('Telegram Trigger').first().json.message.text\n});"
      },
